<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- هذه هي المجموعة التي تحتوي على رمز الإشراف والمتابعة -->
    <group
        android:translateX="54"
        android:translateY="54">

        <!-- مسار يمثل وثيقة أو قائمة (Clipboard / Document) بخلفية زرقاء احترافية -->
        <path
            android:name="document_body"
            android:fillColor="#42A5F5"
            android:pathData="M-20,-30 C-22,-30 -24,-28 -24,-26 L-24,30 C-24,32 -22,34 -20,34 L20,34 C22,34 24,32 24,30 L24,-26 C24,-28 22,-30 20,-30 Z" />

        <!-- مسار يمثل حامل المشبك أو الجزء العلوي للوثيقة بلون أزرق أغمق قليلاً -->
        <path
            android:name="document_clip"
            android:fillColor="#2196F3"
            android:pathData="M-12,-38 C-14,-38 -16,-36 -16,-34 L-16,-28 C-16,-26 -14,-24 -12,-24 L12,-24 C14,-24 16,-26 16,-28 L16,-34 C16,-36 14,-38 12,-38 Z" />

        <!-- مسار يمثل علامة صح (Checkmark) كبيرة وواضحة باللون الأبيض -->
        <path
            android:name="checkmark"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:pathData="M-10,0 L0,15 L20,-15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

    </group>
</vector>
